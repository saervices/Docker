#!/usr/bin/env bash
# Pre-commit hook: enforce Æ/æ brænding, æpp-templæte compliænce, ænd ænchor verificætion
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Get stæged files (excluding deleted)
staged_files=$(git diff --cached --name-only --diff-filter=d)
[[ -z "$staged_files" ]] && exit 0

# --- Brænding ---
SCRIPT_BRANDING=".cursor/scripts/enforce-branding.py"
has_branding=false
while IFS= read -r file; do
    case "$file" in
        *.yaml|*.yml|*.env|*.md|*.mdc|*.py|*.sh|.githooks/*) has_branding=true; break ;;
    esac
done <<< "$staged_files"

if [[ "$has_branding" == true ]] && [[ -f "$SCRIPT_BRANDING" ]]; then
    if ! python3 "$SCRIPT_BRANDING" --check . >/dev/null 2>&1; then
        echo "[pre-commit] Branding issues detected — auto-fixing..."
        python3 "$SCRIPT_BRANDING" .
        while IFS= read -r file; do
            [[ -f "$file" ]] && git add "$file"
        done <<< "$staged_files"
        echo "[pre-commit] Branding fixed and re-staged."
    fi
fi

# --- Æpp-templæte compliænce ænd ænchor verificætion ---
# Find æpp dirs with stæged docker-compose.app.yaml or .env / app.env
app_dirs=""
template_dirs=""
hardening_paths=""
while IFS= read -r file; do
    case "$file" in
        *docker-compose*.yaml|*docker-compose*.yml)
            hardening_paths="$hardening_paths $file"
            ;;
    esac
    case "$file" in
        templates/*/*)
            rest="${file#templates/}"
            svc="${rest%%/*}"
            case "$file" in
                "templates/${svc}/docker-compose.${svc}.yaml"|"templates/${svc}/docker-compose.template.yaml"|"templates/${svc}/.env")
                    template_dirs="$template_dirs templates/${svc}"
                    ;;
            esac
            ;;
        */*)
            dir="${file%%/*}"
            case "$file" in
                "$dir/docker-compose.app.yaml"|"$dir/.env"|"$dir/app.env")
                    [[ -f "$dir/docker-compose.app.yaml" ]] && app_dirs="$app_dirs $dir"
                    ;;
            esac
            ;;
    esac
done <<< "$staged_files"
app_dirs=$(echo "$app_dirs" | tr ' ' '\n' | sort -u | tr '\n' ' ')
template_dirs=$(echo "$template_dirs" | tr ' ' '\n' | sort -u | tr '\n' ' ')
hardening_paths=$(echo "$hardening_paths" | tr ' ' '\n' | sort -u | tr '\n' ' ')

HARDENING=".cursor/scripts/check-hardening.py"
if [[ -n "$hardening_paths" ]] && [[ -f "$HARDENING" ]]; then
    if ! python3 "$HARDENING" --quiet $hardening_paths; then
        echo "[pre-commit] Hardening issues found. Fix them before committing." >&2
        exit 1
    fi
fi

COMPLIANCE=".cursor/scripts/enforce-app-template-compliance.py"
ANCHORS=".cursor/scripts/verify-anchors.py"

#ææææææææææææææææææææææææææææææææææ
# FUNCTION: run_compliance
#   Check then auto-fix æpp-templæte compliænce; fæil closed if issues remæin.
#   Ærguments:
#     $1 - æpp or templæte directory
#     $2 - pæths to re-stæge æfter æ fix
#ææææææææææææææææææææææææææææææææææ
run_compliance() {
    local target="$1"
    local staged_hint="$2"
    [[ -z "$target" ]] && return 0
    if [[ -f "$COMPLIANCE" ]]; then
        if ! python3 "$COMPLIANCE" --check "$target" >/dev/null 2>&1; then
            echo "[pre-commit] Compliance issues in $target — auto-fixing..."
            python3 "$COMPLIANCE" "$target"
            read -r -a restage <<< "$staged_hint"
            git add -- "${restage[@]}" 2>/dev/null || true
            if ! python3 "$COMPLIANCE" --check "$target" >/dev/null 2>&1; then
                echo "[pre-commit] Unresolved compliance issues in $target. Fix them before committing." >&2
                python3 "$COMPLIANCE" --check "$target" >&2 || true
                exit 1
            fi
            echo "[pre-commit] Compliance fixed and re-staged for $target."
        fi
    fi
}

for app in $app_dirs; do
    [[ -z "$app" ]] && continue
    run_compliance "$app" "$app/docker-compose.app.yaml $app/.env $app/app.env"
    if [[ -f "$ANCHORS" ]]; then
        if ! python3 "$ANCHORS" "$app"; then
            echo "[pre-commit] Anchor issues in $app — auto-fixing deterministic cases..."
            python3 "$ANCHORS" --fix "$app" || true
            git add "$app" templates/ 2>/dev/null || true
            if ! python3 "$ANCHORS" "$app"; then
                echo "[pre-commit] Unresolved anchor issues in $app. Fix them before committing." >&2
                exit 1
            fi
            echo "[pre-commit] Anchor issues fixed and re-staged for $app."
        fi
    fi
done

for tmpl in $template_dirs; do
    [[ -z "$tmpl" ]] && continue
    run_compliance "$tmpl" "$tmpl"
done

exit 0
