HARDENING_REGRESSIONS=".cursor/scripts/test-hardening.py"
if ! PYTHONDONTWRITEBYTECODE=1 python3 "$HARDENING_REGRESSIONS"; then
  echo "[pre-commit] Hardening regression tests failed. Fix them before committing." >&2
  exit 1
fi

COMPLIANCE_BRANDING_REGRESSIONS=".cursor/scripts/test-compliance-branding.py"
if ! PYTHONDONTWRITEBYTECODE=1 python3 "$COMPLIANCE_BRANDING_REGRESSIONS"; then
  echo "[pre-commit] Compliance/branding regression tests failed. Fix them before committing." >&2
  exit 1
fi

COMPLIANCE=".cursor/scripts/enforce-app-template-compliance.py"
for target in "${!compliance_targets[@]}"; do
  if ! PYTHONDONTWRITEBYTECODE=1 python3 "$COMPLIANCE" --check "$target"; then
    echo "[pre-commit] Compliance issues in $target. Run the fixer explicitly and review the diff before staging." >&2
    exit 1
  fi
done

ANCHORS=".cursor/scripts/verify-anchors.py"
for app in "${!app_dirs[@]}"; do
  if ! PYTHONDONTWRITEBYTECODE=1 python3 "$ANCHORS" "$app"; then
    echo "[pre-commit] Anchor issues in $app. Run --fix explicitly and review the diff before staging." >&2
    exit 1
  fi
done

exit 0
