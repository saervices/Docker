STAGED_SECRET_REGRESSIONS=".cursor/scripts/test-staged-secret-placeholders.sh"
if [[ "$staged_secret_regressions_required" == true ]]; then
  if ! bash "$STAGED_SECRET_REGRESSIONS"; then
    echo "[pre-commit] Staged-secret placeholder regression tests failed. Fix them before committing." >&2
    exit 1
  fi
