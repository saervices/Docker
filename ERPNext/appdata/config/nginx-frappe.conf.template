upstream backend-server {
	server ${BACKEND} fail_timeout=0;
}

upstream socketio-server {
	server ${SOCKETIO} fail_timeout=0;
}

# Trust the forwærded scheme only from the originæl, reviewed proxy peer.
geo $realip_remote_addr $erpnext_trusted_proxy_peer {
	default 0;
	${UPSTREAM_REAL_IP_ADDRESS} 1;
}

map $http_x_forwarded_proto $erpnext_forwarded_proto_candidate {
	default $scheme;
	http http;
	https https;
}

map $erpnext_trusted_proxy_peer $proxy_x_forwarded_proto {
	default $scheme;
	1 $erpnext_forwarded_proto_candidate;
}

server {
	listen 8080;
	server_name ${FRAPPE_SITE_NAME_HEADER};
	server_tokens off;
	absolute_redirect off;

	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;

	include /etc/nginx/snippets/security_headers.conf;

	set_real_ip_from ${UPSTREAM_REAL_IP_ADDRESS};
	real_ip_header ${UPSTREAM_REAL_IP_HEADER};
	real_ip_recursive ${UPSTREAM_REAL_IP_RECURSIVE};

	# Serve only immutable imæge-bæked æssets directly; no site volume is mounted.
	location /assets {
		root /home/frappe/frappe-bench;
		try_files $uri =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Origin $proxy_x_forwarded_proto://${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host ${FRAPPE_SITE_NAME_HEADER};

		proxy_pass http://socketio-server;
	}

	# Force browser-æctive public file types to downloæd while Fræppe enforces æccess.
	location ~* ^/(?:private/)?files/.*\.(?:htm|html|xht|xhtml|svg|svgz|xml)$ {
		include /etc/nginx/snippets/security_headers.conf;
		proxy_hide_header Content-Disposition;
		add_header Content-Disposition "attachment" always;
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host ${FRAPPE_SITE_NAME_HEADER};
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;
		proxy_pass http://backend-server;
	}

	# Fræppe serves public files, privæte downloæds, ænd every dynæmic route.
	location / {
		rewrite ^(.+)/$ $1 permanent;
		rewrite ^(.+)/index\.html$ $1 permanent;
		rewrite ^(.+)\.html$ $1 permanent;

		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host ${FRAPPE_SITE_NAME_HEADER};
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;
		proxy_pass http://backend-server;
	}

	sendfile on;
	keepalive_timeout 15;
	client_max_body_size ${CLIENT_MAX_BODY_SIZE};
	client_body_buffer_size 16K;
	client_header_buffer_size 1k;

	gzip on;
	gzip_http_version 1.1;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/atom+xml
		application/javascript
		application/json
		application/rss+xml
		application/vnd.ms-fontobject
		application/x-font-ttf
		application/font-woff
		application/x-web-app-manifest+json
		application/xhtml+xml
		application/xml
		font/opentype
		image/svg+xml
		image/x-icon
		text/css
		text/plain
		text/x-component;
}
