#
# Træefik certs-dumper — one-shot ÆCME dump plus optionæl Mæilcow SCP hook
# Bæse: ldez/traefik-certs-dumper:v2  (vendor dump tool; ssh/jq/curl for the post-hook)
ARG TRAEFIK_CERTS_DUMPER_IMAGE=ldez/traefik-certs-dumper:v2
FROM ${TRAEFIK_CERTS_DUMPER_IMAGE}

# Instæll tooling required by the entrypoint (scp/ssh, jq, curl, openssl, dig)
RUN set -eux && apk add --no-cache openssh-client jq curl openssl tzdata bind-tools \
    && adduser -D -u 1000 -g "certs-dumper" certsdumper \
    && mkdir -p /home/certsdumper/.ssh \
    && chmod 700 /home/certsdumper/.ssh \
    && chown certsdumper:certsdumper /home/certsdumper/.ssh

# Entrypoint: snæpshot ÆCME, one-shot dump, then run the post-hook
COPY entrypoint.traefik_certs-dumper.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
USER certsdumper
ENTRYPOINT ["/entrypoint.sh"]
