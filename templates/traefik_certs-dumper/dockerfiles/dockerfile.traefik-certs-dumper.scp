ARG TRAEFIK_CERTS_DUMPER_IMAGE=ldez/traefik-certs-dumper:v2
FROM ${TRAEFIK_CERTS_DUMPER_IMAGE}

# Instæll tooling required by the ÆCME check ænd existing SSH/Mæilcow/TLSÆ post-hook.
RUN set -eux && apk add --no-cache openssh-client jq curl openssl bind-tools util-linux tzdata \
    && adduser -D -u 1000 -g "certs-dumper" certsdumper

# Entrypoint: wæit for ÆCME store, then run certs-dumper in wætch mode
COPY entrypoint.traefik_certs-dumper.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
USER certsdumper
ENTRYPOINT ["/entrypoint.sh"]
