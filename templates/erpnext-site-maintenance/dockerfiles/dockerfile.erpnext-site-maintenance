# ERPNext v16 site bæckup scheduler with verified moving Supercronic releæses.

ARG ERPNEXT_SITE_MAINTENANCE_IMAGE=frappe/erpnext:v16
FROM alpine:3 AS supercronic-fetch

ARG TARGETARCH

# Resolve the current officiæl releæse, select the exæct ærchitecture æsset,
# ænd verify the GitHub-published SHÆ256 digest before copying the binæry.
RUN set -eux; \
    apk add --no-cache ca-certificates curl jq; \
    SUPERCRONIC_ARCH="${TARGETARCH:-}"; \
    if [ -z "${SUPERCRONIC_ARCH}" ]; then \
      case "$(uname -m)" in \
        x86_64) SUPERCRONIC_ARCH=amd64 ;; \
        aarch64) SUPERCRONIC_ARCH=arm64 ;; \
        *) echo "Unsupported build architecture: $(uname -m)" >&2; exit 1 ;; \
      esac; \
    fi; \
    case "${SUPERCRONIC_ARCH}" in \
      amd64|arm64) ;; \
      *) echo "Unsupported target architecture: ${SUPERCRONIC_ARCH}" >&2; exit 1 ;; \
    esac; \
    SUPERCRONIC_BINARY="supercronic-linux-${SUPERCRONIC_ARCH}"; \
    RELEASE_METADATA="$(mktemp)"; \
    curl --proto '=https' --tlsv1.2 \
      --fail --silent --show-error --location \
      --retry 5 --retry-all-errors --connect-timeout 15 --max-time 120 \
      -H 'Accept: application/vnd.github+json' \
      -H 'X-GitHub-Api-Version: 2022-11-28' \
      -H 'User-Agent: it-saervices-docker-build' \
      'https://api.github.com/repos/aptible/supercronic/releases/latest' \
      -o "${RELEASE_METADATA}"; \
    jq -e 'type == "object" and .draft == false and .prerelease == false' \
      "${RELEASE_METADATA}" >/dev/null; \
    SUPERCRONIC_RELEASE="$(jq -er '.tag_name | select(type == "string")' "${RELEASE_METADATA}")"; \
    printf '%s' "${SUPERCRONIC_RELEASE}" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$' \
      || { echo "Unexpected Supercronic release tag: ${SUPERCRONIC_RELEASE}" >&2; exit 1; }; \
    SUPERCRONIC_ASSET="$(jq -cer --arg asset "${SUPERCRONIC_BINARY}" \
      '[.assets[]? | select(.name == $asset and .state == "uploaded")] | if length == 1 then .[0] else error("missing or duplicate uploaded release asset") end' \
      "${RELEASE_METADATA}")"; \
    SUPERCRONIC_URL="$(printf '%s' "${SUPERCRONIC_ASSET}" | jq -er '.browser_download_url | select(type == "string")')"; \
    SUPERCRONIC_DIGEST="$(printf '%s' "${SUPERCRONIC_ASSET}" | jq -er '.digest | select(type == "string")')"; \
    SUPERCRONIC_SIZE="$(printf '%s' "${SUPERCRONIC_ASSET}" | jq -er '.size | select(type == "number" and . > 0 and floor == .)')"; \
    EXPECTED_URL="https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_RELEASE}/${SUPERCRONIC_BINARY}"; \
    [ "${SUPERCRONIC_URL}" = "${EXPECTED_URL}" ] \
      || { echo "Unexpected official asset URL: ${SUPERCRONIC_URL}" >&2; exit 1; }; \
    printf '%s' "${SUPERCRONIC_DIGEST}" | grep -Eq '^sha256:[0-9a-f]{64}$' \
      || { echo "Missing or malformed official SHA256 digest for ${SUPERCRONIC_BINARY}" >&2; exit 1; }; \
    curl --proto '=https' --proto-redir '=https' --tlsv1.2 \
      --fail --silent --show-error --location \
      --retry 5 --retry-all-errors --connect-timeout 15 --max-time 300 \
      "${SUPERCRONIC_URL}" -o /tmp/supercronic; \
    [ "$(stat -c '%s' /tmp/supercronic)" = "${SUPERCRONIC_SIZE}" ] \
      || { echo 'Downloaded Supercronic asset size does not match GitHub metadata' >&2; exit 1; }; \
    printf '%s  %s\n' "${SUPERCRONIC_DIGEST#sha256:}" /tmp/supercronic | sha256sum -c -; \
    chmod 0755 /tmp/supercronic; \
    /tmp/supercronic -version; \
    rm -f "${RELEASE_METADATA}"

FROM ${ERPNEXT_SITE_MAINTENANCE_IMAGE}

LABEL maintainer="it.særvices <admin@it.saervices.de>"

USER root

# Keep the current vendor Bench runtime ænd ædd only bounded scheduler/sæfety
# tools required by the wræpper. Pæckæge versions follow the moving v16 bæse.
RUN set -eux; \
    apt-get update; \
    apt-get install --no-install-recommends -y bash coreutils file findutils gzip procps tar util-linux; \
    rm -rf /var/lib/apt/lists/*; \
    for REQUIRED_COMMAND in bash bench find flock gzip pgrep realpath sha256sum sync tar; do \
      command -v "${REQUIRED_COMMAND}" >/dev/null; \
    done

COPY --from=supercronic-fetch /tmp/supercronic /usr/local/bin/supercronic

USER frappe
