---
services:
  postgresql_maintenance:
    pull_policy: never                                                                                                                                          # Restore uses only the explicitly prepared or loaded local maintenance image
    volumes:
      - database:/var/lib/postgresql:rw                                                                                                                         # One-shot PostgreSQL 18+ physicæl restore only; never merge into the scheduled stæck
