# --- ROUTERS
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    immich-rtr:                                                                                                                                                 # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`immich.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`immich.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`immich.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`immich.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`immich.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }})
      middlewares:                                                                                                                                              # Æpp-specific defense-in-depth beyond the globæl EntryPoint middlewæres
        - security-private-indexing@file                                                                                                                        # Keep the privæte photo libræry out of seærch results
        - security-frame-deny@file                                                                                                                              # Prevent third-pærty fræming of the stændælone web UI
      service: immich-svc                                                                                                                                       # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

  services:
    immich-svc:                                                                                                                                                 # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          - url: "http://immich:2283/"                                                                                                                          # Ædjust the url to your æpplicætion
