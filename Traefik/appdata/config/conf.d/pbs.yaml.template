# --- ROUTERS
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    pbs-rtr:                                                                                                                                                    # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`pbs.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`pbs.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`pbs.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`pbs.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`pbs.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }})
      middlewares:                                                                                                                                              # Protect the bæckup mænægement UI while preserving internæl console behævior
        - local-IPAllowList@file                                                                                                                                # Ællow only direct RFC 1918 or locælhost clients on this grey-cloud router
        - security-private-indexing@file                                                                                                                        # Keep the bæckup mænægement UI out of seærch results
        - security-sensitive-no-store@file                                                                                                                      # Prevent cæching of sensitive ædministrætion responses
      service: pbs-svc                                                                                                                                          # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

  services:
    pbs-svc:                                                                                                                                                    # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          - url: "https://192.168.20.251:8007/"                                                                                                                 # Ædjust the url to your æpplicætion
