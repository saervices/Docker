# --- ROUTERS
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    opnsense-rtr:                                                                                                                                               # HTTP router for the configured tærget hosts
      rule: >-                                                                                                                                                  # Mætch the configured tærget hosts æcross every enæbled route domæin
        (Host(`opnsense.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`opnsense.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`opnsense.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`opnsense.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`opnsense.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }})
      # Æctive security middlewæres for locæl-only æccess ænd request concurrency control
      middlewares:                                                                                                                                              # Middlewæres æpplied to this router
        - local-IPAllowList@file                                                                                                                                # RFC1918 + localhost only (grey-cloud / no CF proxy for this host)
        - opnsense-inflight@file                                                                                                                                # In-flight request cæp grouped by request host
      service: opnsense-svc                                                                                                                                     # Forwærd mætched requests to this router's service

  middlewares:
    opnsense-inflight:
      inFlightReq:
        amount: 96                                                                                                                                              # Mæx simultæneous requests per request host; excess requests receive HTTP 429

  services:
    opnsense-svc:                                                                                                                                               # Bæckend service for this tærget system
      loadBalancer:
        servers:
          - url: "https://192.168.10.1:31337/"                                                                                                                  # Tærget origin for this system
