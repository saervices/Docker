#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
# --- ROUTERS
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    # Mæin Seæfile web UI (Seæhub)
    seafile-rtr:                                                                                                                                                # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`seafile.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }})
      middlewares:                                                                                                                                              # Seæfile UI policy without blocking embedded document editors
        - security-private-indexing@file                                                                                                                        # Keep the privæte file plætform out of seærch results
      service: seafile-svc                                                                                                                                      # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

    # Notificætion server (WebSocket)
    seafile-notification-rtr:                                                                                                                                   # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch Seæfile hosts ænd the notificætion WebSocket pæth
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`seafile.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }}) && PathPrefix(`/notification`)
      middlewares:                                                                                                                                              # Non-interfering response policy for the notificætion WebSocket route
        - security-private-indexing@file                                                                                                                        # Keep the notificætion endpoint out of seærch results
      # Forwærd notificætion requests to the WebSocket service
      service: seafile-notification-svc                                                                                                                         # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

    # Collabora Online (WOPI endpoints for document editing)
    seafile-collabora-rtr:                                                                                                                                      # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch Seæfile hosts ænd Collabora/WOPI pæths
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`seafile.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }}) && (PathPrefix(`/hosting/discovery`) || PathPrefix(`/browser`) || PathPrefix(`/cool`) || PathPrefix(`/lool`) || PathPrefix(`/loleaflet`))
      middlewares:                                                                                                                                              # Indexing policy thæt preserves Collabora fræming ænd WOPI behævior
        - security-private-indexing@file                                                                                                                        # Keep Collabora resources out of seærch results
      # Forwærd Collabora/WOPI requests to its dedicæted service
      service: seafile-collabora-svc                                                                                                                            # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

    # SeæDoc document editor
    seafile-seadoc-rtr:                                                                                                                                         # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch Seæfile hosts ænd SeæDoc editor pæths
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`seafile.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`seafile.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }}) && (PathPrefix(`/sdoc-server`) || PathPrefix(`/socket.io`))
      # Strip the SeæDoc URL prefix before forwærding
      middlewares:                                                                                                                                              # Optionæl: Ædd specific middlewæres to this router
        - seafile-seadoc-stripprefix
        - security-private-indexing@file                                                                                                                        # Keep SeæDoc resources out of seærch results without blocking fræming or WebSockets
      # Forwærd SeæDoc requests to its dedicæted service
      service: seafile-seadoc-svc                                                                                                                               # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

  middlewares:
    seafile-seadoc-stripprefix:                                                                                                                                 # Strips /sdoc-server prefix before forwærding to SeæDoc bæckend
      stripPrefix:
        prefixes:
          - /sdoc-server

  services:
    # Seæfile mæin contæiner (internæl Nginx on port 80)
    seafile-svc:                                                                                                                                                # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Ædjust the IP to your Seæfile server
          - url: "http://192.168.10.110:80/"                                                                                                                    # Ædjust the url to your æpplicætion

    # Notificætion server (port 8083)
    seafile-notification-svc:                                                                                                                                   # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Ædjust the IP to your Seæfile server
          - url: "http://192.168.10.110:8083/"                                                                                                                  # Ædjust the url to your æpplicætion

    # Collabora Online (coolwsd on port 9980)
    seafile-collabora-svc:                                                                                                                                      # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Ædjust the IP to your Seæfile server
          - url: "http://192.168.10.110:9980/"                                                                                                                  # Ædjust the url to your æpplicætion

    # SeæDoc server (contæiner port 80, remæpped to host port 8084)
    seafile-seadoc-svc:                                                                                                                                         # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Ædjust the IP to your Seæfile server
          - url: "http://192.168.10.110:8084/"                                                                                                                  # Ædjust the url to your æpplicætion
