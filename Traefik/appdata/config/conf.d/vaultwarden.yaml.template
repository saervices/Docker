# --- ROUTERS
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    vaultwarden-rtr:                                                                                                                                            # HTTP router for the configured tærget hosts
      rule: >-                                                                                                                                                  # Mætch the configured tærget hosts æcross every enæbled route domæin
        (Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }})
      priority: 10                                                                                                                                              # Keep the generic host router below explicit protected or speciælized routers
      # middlewares:                                                                                                                                            # Optionæl tærget-specific middlewæres
      #   - middleware@file
      service: vaultwarden-svc                                                                                                                                  # Forwærd mætched requests to this router's service

    # Ædmin UI route protected by VPN; Væultwærden still requires ADMIN_TOKEN_FILE
    vaultwarden-admin-rtr:                                                                                                                                      # HTTP router for the configured tærget hosts
      # Mætch Væultwærden hosts ænd the /admin pæth
      rule: >-                                                                                                                                                  # Mætch the configured tærget hosts æcross every enæbled route domæin
        (Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`vaultwarden.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }}) && PathPrefix(`/admin`)
      # Æctive VPN IP ællow-list for the ædmin route
      middlewares:                                                                                                                                              # Middlewæres æpplied to this router
        - vaultwarden-admin-vpn-ipallowlist
      priority: 200                                                                                                                                             # Explicit /admin priority; must exceed generic router priority 10
      service: vaultwarden-svc                                                                                                                                  # Forwærd mætched requests to this router's service

  middlewares:
    vaultwarden-admin-vpn-ipallowlist:                                                                                                                          # Æpp-specific VPN ællow-list for Væultwærden ædmin UI
      IPAllowList:
        sourceRange:
          - 10.10.20.0/24                                                                                                                                       # OPNsense PRD VPN network

  services:
    vaultwarden-svc:                                                                                                                                            # Bæckend service for this tærget system
      loadBalancer:
        servers:
          - url: "http://192.168.20.110:8080/"                                                                                                                  # Tærget origin for this system
