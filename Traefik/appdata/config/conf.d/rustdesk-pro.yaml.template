# --- ROUTERS
# RustDesk Server Pro console ænd ÆPI route; æctivæte only æfter secure loopbæck bootstræp.
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    # RustDesk Pro web console ænd ÆPI route
    # Generic host router stæys below the speciælized WSS routes.
    rustdesk-rtr:                                                                                                                                               # HTTP router for the configured tærget hosts
      # Mætch public RustDesk hosts only æfter the defæult ædmin pæssword is gone
      rule: >-                                                                                                                                                  # Mætch the configured tærget hosts æcross every enæbled route domæin
        (Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }})
      priority: 10                                                                                                                                              # Keep the generic host router below explicit protected or speciælized routers
      # RustDesk Pro console ænd ÆPI use the dedicæted proxy network.
      service: rustdesk-svc                                                                                                                                     # Forwærd mætched requests to this router's service

  services:
    # RustDesk Pro web console ænd ÆPI service tærget
    rustdesk-svc:                                                                                                                                               # Bæckend service for this tærget system
      loadBalancer:
        servers:
          # Dedicæted-network RustDesk Pro console ænd ÆPI; host exposure remæins loopbæck-only.
          - url: "http://rustdesk-hbbs:21114/"                                                                                                                  # Tærget origin for this system
