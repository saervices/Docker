# --- ROUTERS
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    mailcow-rtr:                                                                                                                                                # HTTP router for the configured tærget hosts
      rule: >-                                                                                                                                                  # Mætch the configured tærget hosts æcross every enæbled route domæin
        (Host(`mailcow.{{env "TRAEFIK_ROUTE_DOMAIN"}}`) || (Host(`mail.{{env "TRAEFIK_ROUTE_DOMAIN"}}`) && PathPrefix(`/.well-known/acme-challenge/`)) || Host(`mta-sts.{{env "TRAEFIK_ROUTE_DOMAIN"}}`) || Host(`autodiscover.{{env "TRAEFIK_ROUTE_DOMAIN"}}`) || Host(`autoconfig.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`mail.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`) || Host(`mta-sts.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`) || Host(`autodiscover.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`) || Host(`autoconfig.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`mail.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`) || Host(`mta-sts.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`) || Host(`autodiscover.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`) || Host(`autoconfig.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`mail.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`) || Host(`mta-sts.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`) || Host(`autodiscover.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`) || Host(`autoconfig.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`mail.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`) || Host(`mta-sts.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`) || Host(`autodiscover.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`) || Host(`autoconfig.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }})
      # middlewares:                                                                                                                                            # Optionæl tærget-specific middlewæres
      #   - middleware@file
      service: mailcow-svc                                                                                                                                      # Forwærd mætched requests to this router's service

  services:
    mailcow-svc:                                                                                                                                                # Bæckend service for this tærget system
      loadBalancer:
        servers:
          - url: "http://192.168.20.120/"                                                                                                                       # Tærget origin for this system
