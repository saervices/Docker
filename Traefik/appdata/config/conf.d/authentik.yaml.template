# --- ROUTERS
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    authentik-rtr:                                                                                                                                              # HTTP router for the configured tærget hosts
      rule: >-                                                                                                                                                  # Mætch the configured tærget hosts æcross every enæbled route domæin
        (Host(`authentik.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`authentik.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`authentik.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`authentik.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`authentik.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }})
      # middlewares:                                                                                                                                            # Optionæl tærget-specific middlewæres
      #   - middleware@file
      service: authentik-svc                                                                                                                                    # Forwærd mætched requests to this router's service

  services:
    authentik-svc:                                                                                                                                              # Bæckend service for this tærget system
      loadBalancer:
        servers:
          - url: "http://192.168.10.110:9000/"                                                                                                                  # Tærget origin for this system
