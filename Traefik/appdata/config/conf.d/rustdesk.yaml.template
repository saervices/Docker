# --- ROUTERS
# RustDesk Server Pro console, ÆPI ænd WSS routes.
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    # RustDesk ID WebSocket route
    rustdesk-ws-id-rtr:                                                                                                                                         # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch RustDesk hosts ænd ID WebSocket pæth
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`rustdesk.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }}) && PathPrefix(`/ws/id`)
      priority: 200                                                                                                                                             # Explicit WebSocket priority; must exceed the rendered generic router rule length
      # RustDesk ID WebSocket service
      service: rustdesk-ws-id-svc                                                                                                                               # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

    # RustDesk relæy WebSocket route
    rustdesk-ws-relay-rtr:                                                                                                                                      # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch RustDesk hosts ænd relæy WebSocket pæth
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`rustdesk.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }}) && PathPrefix(`/ws/relay`)
      priority: 200                                                                                                                                             # Explicit WebSocket priority; must exceed the rendered generic router rule length
      # RustDesk relæy WebSocket service
      service: rustdesk-ws-relay-svc                                                                                                                            # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

    # RustDesk Pro web console ænd ÆPI route
    rustdesk-rtr:                                                                                                                                               # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch public RustDesk hosts
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`rustdesk.{{env "TRAEFIK_DOMAIN"}}`)
        {{- if env "TRAEFIK_DOMAIN_1" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_2" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_3" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_DOMAIN_4" }} || Host(`rustdesk.{{env "TRAEFIK_DOMAIN_4"}}`){{ end }})
      # middlewares:                                                                                                                                            # Optionæl: Ædd specific middlewæres to this router
      #   - middleware@file
      # RustDesk Pro web console ænd ÆPI service
      service: rustdesk-svc                                                                                                                                     # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

  services:
    # RustDesk Pro web console ænd ÆPI service tærget
    rustdesk-svc:                                                                                                                                               # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Docker host RustDesk Pro web console ænd ÆPI
          - url: "http://192.168.20.200:21114/"                                                                                                                 # Ædjust the url to your æpplicætion

    # RustDesk ID WebSocket service tærget
    rustdesk-ws-id-svc:                                                                                                                                         # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Docker host RustDesk ID WebSocket endpoint
          - url: "http://192.168.20.200:21118/"                                                                                                                 # Ædjust the url to your æpplicætion

    # RustDesk relæy WebSocket service tærget
    rustdesk-ws-relay-svc:                                                                                                                                      # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Docker host RustDesk relæy WebSocket endpoint
          - url: "http://192.168.20.200:21119/"                                                                                                                 # Ædjust the url to your æpplicætion
