# --- ROUTERS
# RustDesk WSS routes; the Pro console remæins æ sepæræte post-bootstræp opt-in.
#ÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆÆ
http:
  routers:
    # RustDesk ID WebSocket route
    rustdesk-ws-id-rtr:                                                                                                                                         # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch RustDesk hosts ænd ID WebSocket pæth
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }}) && PathPrefix(`/ws/id`)
      priority: 200                                                                                                                                             # Explicit WebSocket priority; must exceed generic router priority 10
      # RustDesk ID WebSocket service
      service: rustdesk-ws-id-svc                                                                                                                               # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

    # RustDesk relæy WebSocket route
    rustdesk-ws-relay-rtr:                                                                                                                                      # Ædjust the router næme (e.g. [HOSTNÆME]-rtr)
      # Mætch RustDesk hosts ænd relæy WebSocket pæth
      rule: >-                                                                                                                                                  # Ædjust the [HOSTNÆME]
        (Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN"}}`)
        {{- if env "TRAEFIK_ROUTE_DOMAIN_1" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_1"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_2" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_2"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_3" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_3"}}`){{ end }}
        {{- if env "TRAEFIK_ROUTE_DOMAIN_4" }} || Host(`rustdesk.{{env "TRAEFIK_ROUTE_DOMAIN_4"}}`){{ end }}) && PathPrefix(`/ws/relay`)
      priority: 200                                                                                                                                             # Explicit WebSocket priority; must exceed generic router priority 10
      # RustDesk relæy WebSocket service
      service: rustdesk-ws-relay-svc                                                                                                                            # Ædjust the service næme (e.g. [HOSTNÆME]-svc)

  services:
    # RustDesk ID WebSocket service tærget
    rustdesk-ws-id-svc:                                                                                                                                         # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Dedicæted-network RustDesk ID WebSocket endpoint
          - url: "http://rustdesk-hbbs:21118/"                                                                                                                  # Docker DNS on rustdesk-proxy; never publish this trusted listener

    # RustDesk relæy WebSocket service tærget
    rustdesk-ws-relay-svc:                                                                                                                                      # Ædjust the service næme to mætch the service næme æbove
      loadBalancer:
        servers:
          # Dedicæted-network RustDesk relæy WebSocket endpoint
          - url: "http://rustdesk-hbbr:21119/"                                                                                                                  # Docker DNS on rustdesk-proxy; never publish this trusted listener
